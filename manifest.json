{
  "manifest_version": 3,
  "name": "Nomi",
  "version": "2.2.8",
  "description": "A minimalist breathing meditation for Chrome.",
  "action": {
    "default_title": "Nomi"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "style_v224.css",
        "app_v228.js",
        "einatmen.mp3",
        "ausatmen.mp3",
        "ende.mp3",
        "icon.png",
        "icon16.png",
        "icon48.png",
        "icon128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}